# Copy this file to .deploy/env and update the values for your target host.
# The deploy.sh, restart.sh, and rollback.sh scripts will automatically source it.

SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"
SUPABASE_ANON_KEY="anon-key-if-needed"
MYXXIT_DASHBOARD_USERNAME="travis"
MYXXIT_DASHBOARD_PASSWORD="change-me-to-a-strong-secret"
DATA_DIR="/opt/myxxit-ops-dashboard/data"
HOST_PORT="4311"
PORT="4311"
TRAEFIK_HOST="ops.myxxit.dev"
TRAEFIK_ENTRYPOINT="websecure"
TRAEFIK_RESOLVER="letsencrypt"
TRAEFIK_ROUTER_NAME="myxxit-ops"
HEALTHCHECK_URL="http://127.0.0.1:4311/healthz"
